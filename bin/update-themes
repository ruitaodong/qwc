#!/usr/bin/env python3
"""Regenerate the QWC2 theme list (themes.json) from the QGIS projects in /web.

Every /web/<name>.qgs becomes a theme served from /wms/<name>. Run
automatically at container start and by qgs.py; run it by hand after copying
.qgs files into /web some other way.
"""

import argparse
import fcntl
import importlib.util
import json
import os
import shutil
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

PROJECTS_DIR = Path(os.environ.get("QWC_PROJECTS_DIR", "/web"))
QWC2_ROOT = Path(os.environ.get("QWC2_ROOT", "/QWC2"))
# Holds QWC2's themesConfig.py plus a "static" symlink to QWC2_ROOT, the
# layout that script expects.
GEN_ROOT = Path(os.environ.get("QWC2_GEN_ROOT", "/opt/qwc2"))
SERVER = os.environ.get("QWC_INTERNAL_URL", "http://localhost")
LOCK = Path(tempfile.gettempdir()) / "update-themes.lock"

SCALES = [100000000, 50000000, 25000000, 10000000, 4000000, 2000000, 1000000,
          400000, 200000, 80000, 40000, 20000, 10000, 8000, 6000, 4000, 2000,
          1000, 500, 250, 100]


def theme(name):
    # Relative URLs, so the browser talks to whatever host it loaded QWC2 from.
    # Set explicitly because QGIS Server would otherwise advertise the
    # internal http://localhost/... URL used while generating.
    wms = f"/wms/{name}"
    return {
        "url": wms,
        "title": name,
        "featureInfoUrl": wms + "?",
        "legendUrl": wms + "?",
        "printUrl": wms + "?",
        "mapCrs": "EPSG:3857",
        "searchProviders": ["coordinates"],
        "backgroundLayers": [],
    }


def themes_config(names):
    default = os.environ.get("QWC_DEFAULT_THEME") or (names[0] if names else None)
    return {
        "defaultScales": SCALES,
        "defaultWMSVersion": "1.3.0",
        "defaultMapCrs": "EPSG:3857",
        "defaultSearchProviders": ["coordinates"],
        "defaultBackgroundLayers": [],
        "defaultTheme": default,
        "themes": {"items": [theme(n) for n in names],
                   "backgroundLayers": [], "externalLayers": []},
    }


def wait_for_server(timeout):
    deadline = time.monotonic() + timeout
    while True:
        try:
            urllib.request.urlopen(SERVER + "/", timeout=2)
            return True
        except Exception:
            if time.monotonic() > deadline:
                return False
            time.sleep(0.5)


def load_generator():
    spec = importlib.util.spec_from_file_location("themesConfig", GEN_ROOT / "themesConfig.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    module.baseUrl = SERVER
    module.qwc2_path = str(GEN_ROOT)
    return module


def relativize(value):
    """Turn http://localhost/... URLs QGIS Server advertised into /... paths."""
    if isinstance(value, dict):
        return {k: relativize(v) for k, v in value.items()}
    if isinstance(value, list):
        return [relativize(v) for v in value]
    if isinstance(value, str) and value.startswith(SERVER + "/"):
        return value[len(SERVER):]
    return value


def write_atomically(path, data):
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".themes-")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--wait", type=float, default=0, metavar="SECONDS",
                   help="wait up to SECONDS for the web server to come up")
    args = p.parse_args(argv)

    # Never replace the published list because the server is (still) down
    if not wait_for_server(args.wait or 5):
        print(f"update-themes: {SERVER} is not reachable, theme list unchanged",
              file=sys.stderr)
        return 1

    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # one regeneration at a time

        names = sorted(f.stem for f in PROJECTS_DIR.glob("*.qgs"))
        # Regenerate map thumbnails too, so they reflect the current projects
        shutil.rmtree(QWC2_ROOT / "assets/img/genmapthumbs", ignore_errors=True)

        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as fh:
            json.dump(themes_config(names), fh)
        try:
            result = load_generator().genThemes(fh.name)
        finally:
            os.unlink(fh.name)

        if "error" in result:
            print(f"update-themes: {result['error']}", file=sys.stderr)
            return 1

        # Projects QGIS Server can't read come back as error entries: leave
        # them out of the client and report them instead.
        items = result["themes"]["items"]
        items[:] = [i for i in items if "error" not in i]
        published = {i["url"].rsplit("/", 1)[-1] for i in items}
        failed = [n for n in names if n not in published]
        if names and not published:
            print("update-themes: no project could be read, theme list unchanged",
                  file=sys.stderr)
            return 1
        if result["themes"].get("defaultTheme") not in {i["id"] for i in items}:
            result["themes"]["defaultTheme"] = items[0]["id"] if items else None

        write_atomically(QWC2_ROOT / "themes.json", relativize(result))

    print(f"update-themes: {len(published)} theme(s) published"
          + (f"; FAILED (see QGIS Server log): {', '.join(failed)}" if failed else ""),
          file=sys.stderr if failed else sys.stdout)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
