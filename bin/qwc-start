#!/bin/sh
# Container entrypoint: build the theme list once Apache is up, run Apache
# in the foreground as the main process.
set -e
# Read by /etc/apache2/sites-available/qwc.conf; 0=info, 1=warning, 2=critical
export QGIS_SERVER_LOG_LEVEL="${QGIS_SERVER_LOG_LEVEL:-1}"
# shellcheck source=/dev/null
. /etc/apache2/envvars
mkdir -p "$APACHE_RUN_DIR" "$APACHE_LOCK_DIR" "$APACHE_LOG_DIR"
rm -f "$APACHE_PID_FILE"
update-themes --wait 60 &
exec apache2 -DFOREGROUND "$@"
